# Loki — guía de despliegue (solo documentación, T36)
#
# Nada de este archivo se ejecuta solo: cada paso lo corre una persona con
# accesos reales. No hay secretos aquí, solo nombres de variables.

# --- 1. Supabase (base de datos, auth, realtime, storage) ---------------------
# Supabase local y migraciones (desarrollo). Requiere WSL2 + Docker.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# ANON_KEY de `npm run sb:status`. Es pública: el aislamiento lo pone la RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Opcionales de conveniencia local (los lee scripts/supabase.mjs si existen).
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
# SUPABASE_PROJECT_REF=

# --- 2. Loki IA (Edge Function loki-chat) --------------------------------------
# Van en `supabase/functions/.env` (gitignored), NO en el cliente.
# LLM_PROVIDER=openai|anthropic|gemini
# LLM_MODEL=
# LLM_API_KEY=
# LLM_BASE_URL= (solo openai-compatible: Groq, OpenRouter, Ollama)
# AI_DAILY_LIMIT=50

# --- 3. Push (Firebase SOLO para FCM + Edge push-send) --------------------------
# Cliente web (sin esto, "Notificaciones no configuradas en este entorno").
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Opt-in de push web (la app solo registra el token si vale "1").
NEXT_PUBLIC_PUSH_ENABLED=
# Servidor: JSON de la cuenta de servicio en `supabase/functions/.env`.
# FCM_SERVICE_ACCOUNT={"project_id":"...","client_email":"...","private_key":"..."}

# --- 4. Google Calendar (Edge Function google-calendar) --------------------------
# Van en `supabase/functions/.env` (gitignored), NO en el cliente.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL= (exacta, p. ej. https://<vercel>/auth/google/callback)
# GOOGLE_TOKEN_KEY= (texto cualquiera de 32+ caracteres, cifra el refresh token)
# Reservada (el flujo actual no la usa: la URL OAuth la genera la Edge):
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
