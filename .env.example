NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=

# T19 en adelante: Supabase (Postgres + RLS + Realtime + Storage). La app sigue
# con Firebase hasta T21; Firebase se queda solo con el push FCM (T24).
# Las claves son las de demo del CLI local: se copian de `npm run sb:status`.
# NUNCA subir claves reales aquí.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# T18: Loki IA apagada en las fases 1-2.
#   false (default) -> la app responde con un mensaje MOCK "[Simulado] ..."
#   true             -> la UI espera a la callable `aiChat` de functions/
#                       (aun NO desplegada: ver functions/README.md).
# Ponerlo en true requiere antes el backend desplegado en el plan Blaze.
NEXT_PUBLIC_AI_ENABLED=false
