{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loki Escritorio",
  "version": "0.1.0",
  "identifier": "cl.loki.desktop",
  "build": {
    "devUrl": "../link.html",
    "frontendDist": "../link.html",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "vincular",
        "title": "Vincular con Loki",
        "url": "link.html",
        "width": 380,
        "height": 460,
        "resizable": false,
        "visible": false,
        "decorations": true,
        "skipTaskbar": false
      }
    ],
    "trayIcon": {
      "iconPath": "../assets/icon.png",
      "tooltip": "Loki Escritorio",
      "menuOnLeftClick": true,
      "title": "Loki"
    },
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["../assets/icon.ico", "../assets/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": [],
    "externalBin": ["bin/loki-desktop"]
  },
  "plugins": {
    "autostart": {
      "active": true
    }
  }
}
