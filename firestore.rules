rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function memberDoc(wsId) {
      return get(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid));
    }

    function isMember(wsId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid));
    }

    function myRole(wsId) {
      return memberDoc(wsId).data.role;
    }

    function isOwner(wsId) {
      return isMember(wsId) && myRole(wsId) == 'owner';
    }

    function isOwnerOrAdmin(wsId) {
      return isMember(wsId) && (myRole(wsId) == 'owner' || myRole(wsId) == 'admin');
    }

    function validWorkspaceName(value) {
      return value is string && value.size() >= 1 && value.size() <= 60;
    }

    function validWorkspaceKind(value) {
      return value == 'family' || value == 'team';
    }

    function validWorkspaceEmoji(value) {
      return value is string && value.size() >= 1 && value.size() <= 16;
    }

    function validChatName(value) {
      return value is string && value.size() >= 1 && value.size() <= 60;
    }

    function chatDoc(wsId, chatId) {
      return get(/databases/$(database)/documents/workspaces/$(wsId)/chats/$(chatId)).data;
    }

    function canAccessChat(wsId, chat) {
      return isMember(wsId)
        && (chat.type in ['group', 'posts']
          || request.auth.uid in chat.get('memberIds', []));
    }

    function canAccessChatId(wsId, chatId) {
      return canAccessChat(wsId, chatDoc(wsId, chatId));
    }

    // Perfil y espejo de membresías: solo el propio usuario.
    match /users/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;
      allow create: if isSelf(uid);
      allow update: if isSelf(uid);
      allow delete: if false;

      match /memberships/{wsId} {
        allow get, list: if isSelf(uid);
        allow create: if isSelf(uid)
          && request.resource.data.wsId == wsId
          && request.resource.data.role in ['owner', 'admin', 'member']
          && getAfter(/databases/$(database)/documents/workspaces/$(wsId)/members/$(uid)).data.uid == uid;
        allow update: if isSelf(uid);
        allow delete: if isSelf(uid);
      }

      // Chat IA personal privado: solo el propio usuario.
      match /aiChats/{chatId} {
        allow read, write: if isSelf(uid);

        match /messages/{mid} {
          // TODO(backend): mover la escritura 'ai' al backend con Admin SDK;
          // permitido aqui solo para el mock de UI.
          allow read, write: if isSelf(uid);
        }
      }
    }

    match /workspaces/{wsId} {
      // Solo miembros pueden leer el doc del espacio (get; sin list global).
      allow get: if isMember(wsId);
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && validWorkspaceName(request.resource.data.name)
        && validWorkspaceKind(request.resource.data.kind)
        && validWorkspaceEmoji(request.resource.data.emoji);
      // Solo owner o admin, sin cambiar ownerId. Si trae nombre/kind/emoji, validarlos.
      allow update: if isOwnerOrAdmin(wsId)
        && request.resource.data.ownerId == resource.data.ownerId
        && (!('name' in request.resource.data) || validWorkspaceName(request.resource.data.name))
        && (!('kind' in request.resource.data) || validWorkspaceKind(request.resource.data.kind))
        && (!('emoji' in request.resource.data) || validWorkspaceEmoji(request.resource.data.emoji));
      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;

      match /members/{memberId} {
        allow get, list: if isMember(wsId);
        // El owner se crea a sí mismo como owner dentro del mismo batch
        // que crea el workspace (se lee el workspace con getAfter),
        // o un owner/admin agrega a otro miembro (TODO: invitaciones).
        allow create: if isSignedIn() && (
          (
            request.auth.uid == memberId
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.role == 'owner'
            && getAfter(/databases/$(database)/documents/workspaces/$(wsId)).data.ownerId == request.auth.uid
          ) || (
            isOwnerOrAdmin(wsId)
            && request.resource.data.uid == memberId
            && request.resource.data.role in ['admin', 'member']
          )
        );
        // Cambio de rol solo para el owner, sin cambiar el uid.
        allow update: if isOwner(wsId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role in ['owner', 'admin', 'member'];
        // El owner puede remover a cualquiera; un miembro puede salir
        // (salvo que sea owner).
        allow delete: if isOwner(wsId)
          || (isSignedIn() && request.auth.uid == memberId && resource.data.role != 'owner');
      }

      match /chats/{chatId} {
        allow get, list: if canAccessChat(wsId, resource.data);
        // existsAfter sobre members/{uid} permite crear el chat general
        // en el mismo batch que crea el espacio y el miembro owner.
        // 'ai' no existe en espacios (solo en users/{uid}/aiChats).
        allow create: if isSignedIn()
          && existsAfter(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid))
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.type in ['group', 'dm', 'posts']
          && validChatName(request.resource.data.name)
          && request.resource.data.memberIds is list
          && (request.resource.data.type != 'dm'
            || request.auth.uid in request.resource.data.memberIds);
        // Cualquier miembro con acceso actualiza lastMessage/updatedAt
        // (lo que hace sendMessage en batch).
        allow update: if canAccessChat(wsId, resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt']);
        // El creador o un owner/admin puede renombrar o cambiar miembros.
        allow update: if canAccessChat(wsId, resource.data)
          && (resource.data.createdBy == request.auth.uid || isOwnerOrAdmin(wsId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'emoji', 'memberIds', 'lastMessage', 'updatedAt'])
          && validChatName(request.resource.data.name)
          && request.resource.data.memberIds is list;
        allow delete: if isMember(wsId)
          && (resource.data.createdBy == request.auth.uid || isOwner(wsId));

        match /messages/{messageId} {
          allow get, list: if canAccessChatId(wsId, chatId);
          // 'ai' solo lo escribe el backend con Admin SDK: prohibido al cliente.
          allow create: if canAccessChatId(wsId, chatId)
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.type in ['user', 'post', 'system']
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 4000
            && request.resource.data.reactions.size() == 0
            && request.resource.data.threadCount == 0
            && request.resource.data.deleted == false
            && request.resource.data.createdAt == request.time;
          // El autor edita su texto (o borra en suave).
          allow update: if canAccessChatId(wsId, chatId)
            && resource.data.authorId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentions', 'editedAt', 'deleted', 'attachments'])
            && request.resource.data.editedAt == request.time
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 4000;
          // Cualquier miembro con acceso alterna solo su propio uid en un emoji.
          allow update: if canAccessChatId(wsId, chatId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'lastReaction'])
            && request.resource.data.lastReaction.uid == request.auth.uid
            && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.resource.data.lastReaction.emoji])
            && request.resource.data.reactions.get(request.resource.data.lastReaction.emoji, []).toSet().union(resource.data.reactions.get(request.resource.data.lastReaction.emoji, []).toSet()).difference(request.resource.data.reactions.get(request.resource.data.lastReaction.emoji, []).toSet().intersection(resource.data.reactions.get(request.resource.data.lastReaction.emoji, []).toSet())) == [request.auth.uid].toSet();
          // Cualquier miembro con acceso suma una respuesta al hilo (+1 exacto).
          allow update: if canAccessChatId(wsId, chatId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['threadCount', 'lastReplyAt'])
            && request.resource.data.threadCount == resource.data.threadCount + 1;
          allow delete: if canAccessChatId(wsId, chatId)
            && resource.data.authorId == request.auth.uid;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
