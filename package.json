{
  "name": "loki",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "build:capacitor": "node scripts/build-capacitor.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start --project demo-loki",
    "emulators:export": "firebase emulators:start --project demo-loki --export-on-exit .emulator-data --import .emulator-data",
    "test:rules:run": "node --test --test-concurrency=1 tests/firestore.rules.test.mjs tests/chat.rules.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-loki --only firestore \"npm run test:rules:run\"",
    "test:mentions": "node tests/mentions.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.104.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "framer-motion": "^13.4.4",
    "lucide-react": "^1.48.0",
    "next": "15.5.26",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "firebase-tools": "^15.31.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
